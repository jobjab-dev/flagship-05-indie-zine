---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { MeterStatusBadge } from "../components/islands/MeterStatusBadge";
import { QaDrawer } from "../components/islands/QaDrawer";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "PRESS 09 — Independent Tokyo & Zurich Risograph Digital Culture Zine",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%230038FF'/><circle cx='16' cy='16' r='7' fill='%23E9FF32'/></svg>"
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Martian+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F7F6F2] text-[#111111]">
    <header class="border-b-2 border-[#111111] bg-[#F7F6F2]">
      <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-4 px-5 py-3.5">
        <a href="/" class="flex items-baseline gap-3 group">
          <span class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-[#0038FF] group-hover:text-[#FF3B6B] transition-colors">
            PRESS 09
          </span>
          <span class="hidden sm:inline font-mono text-[11px] uppercase tracking-wider text-[#55534D]">
            TOKYO / ZURICH RISOGRAPH EDITION
          </span>
        </a>

        <div class="flex items-center gap-3">
          <MeterStatusBadge client:load />
          <a
            href="/"
            class="border border-[#111111] px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider hover:bg-[#111111] hover:text-[#E9FF32] transition-colors"
          >
            Issue Index
          </a>
        </div>
      </div>
    </header>

    <div class="flex-1">
      <slot />
    </div>

    <footer class="mt-12 border-t-2 border-[#111111] bg-[#ECEAE2]/70 px-5 py-4">
      <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[#55534D]">
        <span>
          PRESS 09 · ASTRO SSR VIEW TRANSITIONS + REACT ISLANDS + METERED PAYWALL
        </span>
        <span>
          Crafted by{" "}
          <a
            href="https://github.com/jobjab-dev"
            target="_blank"
            rel="noreferrer"
            class="text-[#0038FF] underline underline-offset-4 hover:text-[#111111]"
          >
            jobjab-dev
          </a>
        </span>
      </div>
    </footer>

    <QaDrawer client:load />
  </body>
</html>
